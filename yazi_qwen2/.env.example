# ==============================================================================
# DEEPSEEK API KONFIGURASYONU (OPSIYONEL - YENI SENTETIK VERI URETIMI ICIN)
# ==============================================================================
# Bu dosyayı '.env' olarak kopyalayıp kendi API anahtarınızı tanımlayabilirsiniz:
# cp .env.example .env

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CACHE_DIR=.cache/deepseek_cache
